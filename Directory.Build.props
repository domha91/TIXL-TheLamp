<!-- Generated by TiXL: keeps build output out of the project content, in .temp/ -->
<Project>
  <PropertyGroup>
    <BaseOutputPath>.temp/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>.temp/obj/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>.temp/obj/</MSBuildProjectExtensionsPath>
    <!-- The SDK only auto-excludes the configured output paths; stale root-level bin/obj from
         the previous format would otherwise enter the compile glob as duplicate sources -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>